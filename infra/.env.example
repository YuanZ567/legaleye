# ─────────────────────────────────────────────
# LegalEye 环境变量模板
# 复制为 .env 后按需修改：cp .env.example .env
# 禁止将 .env 提交到 git
# ─────────────────────────────────────────────

# ── 数据库（Postgres + pgvector）──
POSTGRES_DB=legaleye
POSTGRES_USER=legaleye
POSTGRES_PASSWORD=legaleye_dev_password
# 后端容器内连接串（compose 服务名 postgres）
DATABASE_URL=postgresql+psycopg://legaleye:legaleye_dev_password@postgres:5432/legaleye

# ── Redis（Celery / demo 限流 / SSE 进度桥）──
REDIS_URL=redis://redis:6379/0

# ── MinIO（文件存储）──
MINIO_ROOT_USER=legaleye_minio
MINIO_ROOT_PASSWORD=legaleye_minio_password
MINIO_BUCKET=legaleye-docs
MINIO_ENDPOINT=minio:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000

# ── 安全（必填）──
# Fernet 主密钥生成：
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
LEGALEYE_SECRET_KEY=
# JWT 签名密钥（随机长字符串）
JWT_SECRET=
JWT_ACCESS_EXPIRE_MINUTES=120
JWT_REFRESH_EXPIRE_DAYS=7

# ── 应用 ──
APP_ENV=development
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO

# ── LLM（M4 起使用；demo 免 Key 走系统默认百炼）──
BAILIAN_API_KEY=
BAILIAN_MODEL=qwen-plus
DEMO_DAILY_LIMIT=5

# ── 任务（Celery / 熔断）──
CELERY_WORKER_CONCURRENCY=2
TASK_TIMEOUT_SECONDS=600
MAX_TASK_TOKENS=400000

# ── 可观测（可选）──
SENTRY_DSN=
